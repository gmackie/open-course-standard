{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OCS v0.1 package root",
  "type": "object",
  "required": ["specVersion", "kind", "id", "version", "metadata"],
  "properties": {
    "specVersion": { "const": "0.1" },
    "kind": { "enum": ["Course", "Codex", "Activity", "AssessmentBlueprint", "Collection", "Package", "Program"] },
    "id": { "$ref": "#/$defs/packageId" },
    "version": { "$ref": "#/$defs/version" },
    "metadata": {
      "type": "object",
      "required": ["title"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "language": { "type": "string", "minLength": 2 },
        "license": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "path"],
        "properties": {
          "id": { "$ref": "#/$defs/resourceId" },
          "kind": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "entrypoints": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/resourceId" }
    },
    "composition": { "type": "string", "minLength": 1 },
    "extensions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "version", "required"],
        "properties": {
          "id": { "type": "string", "minLength": 3 },
          "version": { "$ref": "#/$defs/version" },
          "required": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "packageId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*/[a-z0-9][a-z0-9._-]*$" },
    "resourceId": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$" },
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$" }
  }
}
