{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OCS v0.1 assessment blueprint (experimental)",
  "type": "object",
  "required": ["kind", "id", "metadata", "evidence", "approval"],
  "properties": {
    "kind": { "const": "AssessmentBlueprint" },
    "id": { "type": "string", "minLength": 1 },
    "metadata": { "type": "object", "required": ["title"], "properties": { "title": { "type": "string", "minLength": 1 } }, "additionalProperties": true },
    "goals": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "object", "required": ["id", "artifactType"], "properties": { "id": { "type": "string" }, "artifactType": { "type": "string" }, "criterion": { "type": "string" } }, "additionalProperties": true }
    },
    "generation": { "type": "object", "properties": { "mode": { "enum": ["manual", "per-offering", "per-term"] } }, "additionalProperties": true },
    "evaluation": { "type": "object", "additionalProperties": true },
    "approval": {
      "type": "object",
      "required": ["required", "authority"],
      "properties": { "required": { "type": "boolean" }, "authority": { "type": "string", "minLength": 1 } },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
