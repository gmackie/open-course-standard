      "text": "{\n  \"activity\": {\n    \"aiHelp\": \"hints-only\",\n    \"due\": {\n      \"days\": 7,\n      \"kind\": \"after-install\"\n    },\n    \"gradeBand\": \"3-5\",\n    \"overview\": \"Listen to a short poem and talk about one image in it.\",\n    \"passage\": \"The fog comes on little cat feet.\",\n    \"questions\": [\n      {\n        \"prompt\": \"What animal does the fog move like?\"\n      }\n    ],\n    \"resources\": [\n      \"fog\"\n    ],\n    \"subject\": \"english-language-arts\",\n    \"template\": \"read-and-respond\",\n    \"title\": \"An image in a poem\"\n  },\n  \"alignments\": [\n    {\n      \"competencyUri\": \"https://standards.example.org/competency/42\",\n      \"frameworkKey\": \"example-framework\"\n    }\n  ],\n  \"id\": \"example.net/poem-image\",\n  \"language\": \"en\",\n  \"readings\": [\n    {\n      \"attribution\": \"Carl Sandburg, Fog (1916). Public domain.\",\n      \"body\": \"The fog comes on little cat feet.\",\n      \"id\": \"fog\",\n      \"title\": \"Fog (excerpt)\"\n    }\n  ],\n  \"rubric\": {\n    \"criteria\": [\n      {\n        \"id\": \"image\",\n        \"levels\": [\n          {\n            \"id\": \"not-yet\",\n            \"label\": \"Not yet\",\n            \"points\": 0\n          },\n          {\n            \"id\": \"yes\",\n            \"label\": \"Yes\",\n            \"points\": 2\n          }\n        ],\n        \"title\": \"Names the image\"\n      }\n    ],\n    \"title\": \"Talking about an image\"\n  },\n  \"specVersion\": \"1.1\",\n  \"version\": \"1.0.0\"\n}\n",
