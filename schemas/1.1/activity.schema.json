  "$id": "https://raw.githubusercontent.com/gmackie/open-course-standard/main/schemas/1.1/activity.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A pointer to an activity definition, district-local or portable. See https://github.com/gmackie/open-course-standard/blob/main/spec/ocs-1.1.md §7.2. Normative for structure (OCS 1.1 §1). Rules a schema cannot express, such as references between files, uniqueness within lists, and the digest and signature checks, are stated in the specification.",
  "properties": {
    "definition": {
      "anyOf": [
