{
  "$comment": "Generated from the reference implementation (packages/ocs/scripts/generate-schemas.ts); do not edit. License: CC-BY-4.0.",
  "$id": "https://raw.githubusercontent.com/gmackie/open-course-standard/main/schemas/1.1/codex-note.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Context for a course: a student overview, a teacher guide or an answer key. See https://github.com/gmackie/open-course-standard/blob/main/spec/ocs-1.1.md §7.4. Normative for structure (OCS 1.1 §1). Rules a schema cannot express, such as references between files, uniqueness within lists, and the digest and signature checks, are stated in the specification.",
  "properties": {
    "body": {
      "maxLength": 20000,
      "minLength": 1,
      "not": {
        "pattern": "<\\s*\\/?\\s*([sS][cC][rR][iI][pP][tT]|[iI][fF][rR][aA][mM][eE]|[oO][bB][jJ][eE][cC][tT]|[eE][mM][bB][eE][dD]|[aA][pP][pP][lL][eE][tT]|[sS][tT][yY][lL][eE]|[lL][iI][nN][kK]|[mM][eE][tT][aA]|[bB][aA][sS][eE]|[fF][oO][rR][mM]|[sS][vV][gG])\\b|\\b([jJ][aA][vV][aA][sS][cC][rR][iI][pP][tT]|[vV][bB][sS][cC][rR][iI][pP][tT])\\s*:|[dD][aA][tT][aA]\\s*:\\s*[tT][eE][xX][tT]\\/[hH][tT][mM][lL]"
      },
      "pattern": "\\S",
      "type": "string"
    },
    "id": {
      "pattern": "^[a-z][a-z0-9-]{0,62}$",
      "type": "string"
    },
    "purpose": {
      "enum": [
        "context",
        "answer-key"
      ],
      "type": "string"
    },
    "title": {
      "maxLength": 200,
      "minLength": 1,
      "not": {
        "pattern": "<\\s*\\/?\\s*([sS][cC][rR][iI][pP][tT]|[iI][fF][rR][aA][mM][eE]|[oO][bB][jJ][eE][cC][tT]|[eE][mM][bB][eE][dD]|[aA][pP][pP][lL][eE][tT]|[sS][tT][yY][lL][eE]|[lL][iI][nN][kK]|[mM][eE][tT][aA]|[bB][aA][sS][eE]|[fF][oO][rR][mM]|[sS][vV][gG])\\b|\\b([jJ][aA][vV][aA][sS][cC][rR][iI][pP][tT]|[vV][bB][sS][cC][rR][iI][pP][tT])\\s*:|[dD][aA][tT][aA]\\s*:\\s*[tT][eE][xX][tT]\\/[hH][tT][mM][lL]"
      },
      "pattern": "\\S",
      "type": "string"
    },
    "visibility": {
      "enum": [
        "students",
        "teacher-only"
      ],
      "type": "string"
    }
  },
  "required": [
    "id",
    "title",
    "body",
    "purpose",
    "visibility"
  ],
  "title": "OCS Codex note (codex/<id>.json)",
  "type": "object"
}
